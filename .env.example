# Anthropic (used by claude-agent-sdk; optional if `claude` CLI is already authenticated)
ANTHROPIC_API_KEY=

# Langfuse (optional — tracing is skipped when unset)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com

# Optional deployment overrides. Leave unset for workspace/ + data/app.db.
# WORKSPACE_DIR=/absolute/private/workspace
# DATABASE_URL=postgresql+psycopg://user:password@host/database
